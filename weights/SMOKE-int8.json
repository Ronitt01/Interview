    "hidden_size": 256,
    "dropout": 0.1,
    "freeze_encoder": true,
    "unfreeze_top_blocks": 0,
    "n_mels": 80,
    "d_model": 384,
    "encoder_layers": 4,
    "n_positions": 50,
